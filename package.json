{
  "name": "console-publisher-worker",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/workers-types": "5.20261028.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  },
  "engines": {
    "node": ">=24",
    "yarn": ">=1.22 <2"
  }
}
