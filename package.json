{
  "name": "console-publisher-worker",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@cloudflare/workers-types": "5.20261022.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  },
  "engines": {
    "node": ">=24.22.1",
    "yarn": ">=1.22 <2"
  }
}
