{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "console-publisher-worker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "console.gi.org.pl/api/buffer/*", "zone_name": "gi.org.pl" },
    { "pattern": "console.gi.org.pl/buffer-media/*", "zone_name": "gi.org.pl" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "console-buffer-media" }],
  "vars": {
    "APP_ORIGIN": "https://console.gi.org.pl",
    "ACCESS_TEAM_DOMAIN": "https://generacja-innowacja.cloudflareaccess.com",
    "ACCESS_AUD": "d8f485cd8ccc3d67d97632e7db40bc2c4a72dc4fe059f36d1f796d11478f162d",
    "SERVICES_JSON": "[{\"clientId\":\"c62ff145e5d2ef24a34663f4761b2f5b.access\",\"name\":\"gieniek-bot\",\"channelIds\":[\"6abad324ea19ca0bde183f6c\",\"6abad2b0ea19ca0bde183c40\",\"6aba96d1ea19ca0bde14e49a\"],\"minScheduleLeadMinutes\":120}]",
    "CHANNELS_JSON": "[{\"id\":\"6abad324ea19ca0bde183f6c\",\"name\":\"giorgpl\",\"service\":\"linkedin\"},{\"id\":\"6abad2b0ea19ca0bde183c40\",\"name\":\"Generacja Innowacja\",\"service\":\"facebook\"},{\"id\":\"6aba96d1ea19ca0bde14e49a\",\"name\":\"generacjainnowacja\",\"service\":\"instagram\"}]"
  }
}
